# 模型 API 地址 + Token 模板。
# 地址留空 = 使用 openclaw.json 中该 provider 的默认地址（见下方注释）。
# Token 留空 = 未认证，Gateway 仍会启动，调用该模型时报认证错误。
# 只改地址或只填 Token 都可以；修改后执行 ./deploy.sh 生效。

# DeepSeek（默认 https://api.deepseek.com）
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=

# 通义千问 DashScope 国内 Standard（默认 https://dashscope.aliyuncs.com/compatible-mode/v1）
QWEN_BASE_URL=
QWEN_API_KEY=

# 智谱 GLM 国内（默认 https://open.bigmodel.cn/api/paas/v4）
ZAI_BASE_URL=
ZAI_API_KEY=

# Moonshot Kimi 国内（默认 https://api.moonshot.cn/v1）
MOONSHOT_BASE_URL=
MOONSHOT_API_KEY=

# 火山方舟豆包（默认 https://ark.cn-beijing.volces.com/api/v3）
VOLCANO_ENGINE_BASE_URL=
VOLCANO_ENGINE_API_KEY=

# 腾讯混元 TokenHub（默认 https://tokenhub.tencentmaas.com/v1）
TOKENHUB_BASE_URL=
TOKENHUB_API_KEY=

# StepFun（默认 https://api.stepfun.ai/v1）
STEPFUN_BASE_URL=
STEPFUN_API_KEY=

# MiniMax（镜像自带 provider，地址由插件决定）
MINIMAX_API_KEY=

# 任意 OpenAI 兼容端点：地址和 Token 都填，并在 openclaw.json 增加 provider（见文档 6.2）
# MY_API_BASE_URL=https://your-api.example.com/v1
# MY_API_TOKEN=sk-xxxx
