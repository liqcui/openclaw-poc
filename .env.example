# 复制为 .env 后按需修改（deploy.sh 会自动创建并生成 token）
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# 留空则使用 ${HOME}/.openclaw
OPENCLAW_CONFIG_DIR=
OPENCLAW_WORKSPACE_DIR=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=lan
# 生成方式：openssl rand -hex 32（留空时 deploy.sh 自动生成）
OPENCLAW_GATEWAY_TOKEN=

# 留空则使用 ${HOME}/.openclaw/workspace/skills
OPENCLAW_SKILLS_DIR=
