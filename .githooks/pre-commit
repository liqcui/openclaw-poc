#!/usr/bin/env bash
# 提交前保护：拒绝把本地密钥文件加入提交。
# 启用：git config core.hooksPath .githooks
set -euo pipefail

blocked=()
while IFS= read -r path; do
  [ -n "$path" ] || continue
  base="${path##*/}"
  case "$base" in
    .env | .env.*)
      case "$base" in
        .env.example | .env.models.example) ;;
        *) blocked+=("$path") ;;
      esac
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#blocked[@]}" -gt 0 ]; then
  printf '拒绝提交：以下本地密钥文件已暂存\n' >&2
  printf '  %s\n' "${blocked[@]}" >&2
  printf '\n取消暂存后重试：git rm --cached -- <文件>\n' >&2
  exit 1
fi
